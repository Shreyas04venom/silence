# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# EmailJS Configuration (for Contact Form)
# Get your keys from: https://dashboard.emailjs.com/admin/account
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ADMIN=your_admin_template_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_USER=your_user_template_id_here

# Gemini API Keys (comma-separated for rotation)
GEMINI_API_KEY=your_gemini_api_keys_here

# Local Video Backend (optional, requires NVIDIA GPU)
LOCAL_VIDEO_API_URL=http://127.0.0.1:8000/generate-video

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# YouTube Data API v3 Key (for educational video search)
YOUTUBE_API_KEY=your_youtube_api_keys_here

# Google Custom Search API Key (for image search)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
