NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional cloud fallback for lesson text/storyboards and Veo video.
# You can leave this empty if you want the app to run with local fallback content.
GEMINI_API_KEY=

# Optional Veo settings. Used only when LOCAL_VIDEO_API_URL is not set.
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p

# Preferred free local video backend. Point this to the sample FastAPI backend
# in ./local-video-backend when running on a stronger NVIDIA laptop/desktop.
LOCAL_VIDEO_API_URL=http://127.0.0.1:8000/generate-video

# YouTube Data API v3 key — for finding animated educational videos
YOUTUBE_API_KEY=
